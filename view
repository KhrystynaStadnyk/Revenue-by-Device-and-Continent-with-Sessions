CREATE VIEW `Students.v_Stadnyk_es_by_month` AS

WITH email_data AS (
  SELECT
DATE_ADD(s.date, INTERVAL es.sent_date DAY) AS sent_date,
DATE_TRUNC(DATE_ADD(s.date, INTERVAL es.sent_date DAY), MONTH) as sent_month,
es.id_account as id_account

FROM `DA.email_sent` as es
join `DA.account_session` as acs
on es.id_account = acs.account_id
join `DA.session` as s
on acs.ga_session_id = s.ga_session_id
),
-- підрахунок кількості відправлених листів за місяць, перша та остання дату надсилання імейла
account_month AS (
  SELECT
    sent_month,
    id_account,
    COUNT(*) AS sent_msg_count,
    MIN(sent_date) AS first_sent_date,
    MAX(sent_date) AS last_sent_date
  FROM email_data
  GROUP BY sent_month, id_account
),
-- загальна кількість надісланих листів
total_email AS (
SELECT
  sent_month,
  COUNT (*) as total_letter_count
 FROM email_data
 GROUP BY sent_month

)
--final query
SELECT
am.sent_month,
am.id_account,
am.sent_msg_count/ te.total_letter_count *100.0 as  sent_msg_percent_from_this_month,
am.first_sent_date,
am.last_sent_date
FROM account_month as am
join total_email  as te
on am.sent_month = te.sent_month
